.fab-container {
    position: absolute;
    bottom: 96px;
    right: var(--safe-area-right);
    align-items: flex-end;
}

.fab__icon {
    width: 28px;
    height: 28px;
    -unity-background-image-tint-color: var(--palette-sky-white);

    transition-property: rotate;
    transition-duration: 0.25s;
    transition-timing-function: ease-in-out;
}

.fab__icon--active {
    rotate: 45deg;
}

.fab__menu {
    background-color: transparent;
    border-width: 0;
    padding: 0;
    margin-bottom: var(--spacing-sm);
    align-items: flex-end;
}

.fab__menu-item {
    margin: 0;
    margin-bottom: var(--spacing-xs);

    opacity: 0;
    visibility: hidden;
    translate: 0 15px;
    scale: 0.8;

    transition-property: opacity, translate, scale, visibility;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-back;
}

.fab__menu--active .fab__menu-item {
    opacity: 1;
    visibility: visible;
    translate: 0 0;
    scale: 1;
}

.fab-menu-button {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    transition-property: scale;
    transition-duration: 0.1s;
    transition-timing-function: ease-out;
}

.fab-menu-button:active {
    scale: 0.96 0.96;
}

.fab-menu-button__label-container {
    background-color: var(--palette-sky-white);
    padding: 12px 20px;
    border-radius: 24px;
    margin-right: 16px;
}

.fab-menu-button__label-text {
    color: var(--text-color-main);
    font-size: 16px;
    padding: 0;
    margin: 0;
}

.fab-menu-button__circle {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    justify-content: center;
    align-items: center;
    background-color: var(--palette-primary-base);
}

.fab-menu-button__icon {
    width: 32px;
    height: 32px;
    -unity-background-image-tint-color: var(--palette-sky-white);
}


