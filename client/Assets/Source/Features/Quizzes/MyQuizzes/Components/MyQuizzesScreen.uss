.quiz-card {
    background-color: var(--palette-sky-white);
    border-radius: var(--radius-m);
    border-width: 1px;
    border-color: var(--palette-sky-light);
    padding: 16px;
    margin-bottom: 12px;
    display: flex;
    flex-direction: column;
}

.quiz-card__header {
    display: flex;
    flex-direction: column;
}

.quiz-card__title-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
}

.quiz-card__progress-bar {
    margin-top: var(--spacing-xs);
    margin-bottom: var(--spacing-xs);
}

.quiz-card__subtitle {
    color: var(--text-color-subtle);
}

.quiz-card__questions-label {
    color: var(--text-color-subtle);
}

.quiz-card__stats-row {
    display: flex;
    flex-direction: row;
    justify-content: space-between;
    align-items: flex-end;
    margin-top: 18px;
    margin-bottom: 8px;
}

.quiz-card__tags-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin-top: 6px;
    margin-bottom: 2px;
}

.no-quizzes {
    flex-grow: 1;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    padding: var(--spacing-xxl);
}

.no-quizzes__icon {
    width: 64px;
    height: 64px;
    margin-bottom: var(--spacing-m);
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--palette-sky-light);
}

.no-quizzes__title {
    color: var(--palette-ink-darkest);
    margin-bottom: var(--spacing-xs);
    white-space: normal;
    -unity-text-align: middle-center;
}

.no-quizzes__description {
    color: var(--palette-ink-lighter);
    margin-bottom: var(--spacing-l);
    white-space: normal;
    -unity-text-align: middle-center;
}

.no-quizzes__button {
    min-width: 160px;
}
